# Copy this file to .env for local development (npm run dev).
# On Vercel, add the same keys under Project -> Settings -> Environment Variables.

# --- Softr (required) -------------------------------------------------------
# Softr -> Settings -> API keys. Server-side only, never shown in the browser.
SOFTR_API_KEY=
SOFTR_DATABASE_ID=3478ccf5-6d0c-40d5-bf2a-6fe98b07e458
SOFTR_TICKETS_TABLE_ID=Jh6LL5wrTxutsm
SOFTR_REPLIES_TABLE_ID=zhgRdaT4MC8DVF
# Optional: enables the weekly hours bar for developers. Leave blank to hide it.
SOFTR_WEEKS_TABLE_ID=PV8h5eiLBdfCsZ

# --- Access (required) ------------------------------------------------------
# Password developers use to open the full board.
DEV_PASSWORD=
# Developer emails allowed to use that password, comma separated.
DEV_EMAILS=
# Client emails allowed to sign in, comma separated. "@company.com" allows a whole domain.
CLIENT_EMAILS=jane@client.com, @anotherclient.com
# Long random string used to sign sessions, e.g. run: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# --- Attachments (optional) -------------------------------------------------
# Vercel -> Storage -> Create Blob store -> connect to this project. Vercel adds
# this variable automatically. Without it, the portal works but hides file uploads.
BLOB_READ_WRITE_TOKEN=

# --- Optional ---------------------------------------------------------------
# Name shown on developer replies.
TEAM_NAME=Team
# Adds an "Open in Softr" link for developers. {id} is replaced with the record id.
SOFTR_RECORD_URL=
